# Development-only values. Use a secret manager and unique credentials outside local development.
POSTGRES_PASSWORD=procurement_dev_only
ADMIN_API_TOKENS=source_approver:replace-this-development-token
PUBLIC_RATE_LIMIT_PER_MINUTE=120
QUERY_PARSER_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Mouser Search API: leave blank until access is approved. Never commit a real key.
MOUSER_API_KEY=
# Hard safety ceilings; application clamps these to 5/minute and 100/day.
MOUSER_MAX_CALLS_PER_MINUTE=5
MOUSER_MAX_CALLS_PER_DAY=100

# Set filesystem locally or s3 for an S3/MinIO-compatible raw-capture bucket.
RAW_CAPTURE_BACKEND=s3
S3_RAW_CAPTURE_BUCKET=procurement-raw-captures
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
